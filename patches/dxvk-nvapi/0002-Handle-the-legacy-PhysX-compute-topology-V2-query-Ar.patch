From f9ddebf94c593bf2891bb6967db6f263ad04080d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Christian=20K=C3=BCndig?= <christian@kuendig.info>
Date: Sat, 10 Oct 2026 14:41:44 +0200
Subject: [PATCH 2/2] Handle the legacy PhysX compute topology V2 query (Arkham
 Asylum)

NvAPI_GPU_CudaEnumComputeCapableGpus now accepts NV_COMPUTE_GPU_TOPOLOGY_VER
(V2) as well as V1. PhysXDevice 2.8.4 initializes only the version field, so
gpuCount and computeGpus are treated as outputs: the V2 result points at
driver-owned (thread-local) storage, as ZLUDA's own NVAPI does, and the
caller's pointer is never dereferenced. The private V2-only entry point
0x36e39e6b that legacy PhysX requests through nvapi_QueryInterface reuses
the same checked enumerator. The sysinfo test covers V2 with poisoned
outputs and with a null array, and its RADV expectation now matches the
DXVK_NVAPI_ALLOW_OTHER_DRIVERS=1 behaviour from 9ee7d01.

Assisted-by: Claude:claude-fable-5.1
Assisted-by: Codex:gpt-6.1-sol
---
 src/nvapi_gpu.cpp       | 20 +++++++++++++++++++-
 src/nvapi_interface.cpp | 24 ++++++++++++++++++++++++
 tests/nvapi_sysinfo.cpp | 25 +++++++++++++++++++++----
 3 files changed, 64 insertions(+), 5 deletions(-)

diff --git a/src/nvapi_gpu.cpp b/src/nvapi_gpu.cpp
index 812bfbe..f75a7b9 100644
--- a/src/nvapi_gpu.cpp
+++ b/src/nvapi_gpu.cpp
@@ -675,7 +675,7 @@ NVAPI_FUNCTION NvAPI_GPU_CudaEnumComputeCapableGpus(NV_COMPUTE_GPU_TOPOLOGY* pCo
     if (!pComputeTopo)
         return InvalidArgument(n);
 
-    if (pComputeTopo->version != NV_COMPUTE_GPU_TOPOLOGY_VER1)
+    if (pComputeTopo->version != NV_COMPUTE_GPU_TOPOLOGY_VER1 && pComputeTopo->version != NV_COMPUTE_GPU_TOPOLOGY_VER)
         return IncompatibleStructVersion(n, pComputeTopo->version);
 
     // ZLUDA-Physx: When DXVK_NVAPI_ALLOW_OTHER_DRIVERS=1, non-NVIDIA
@@ -701,12 +701,30 @@ NVAPI_FUNCTION NvAPI_GPU_CudaEnumComputeCapableGpus(NV_COMPUTE_GPU_TOPOLOGY* pCo
         case NV_COMPUTE_GPU_TOPOLOGY_VER1: {
             auto pComputeTopoV1 = reinterpret_cast<NV_COMPUTE_GPU_TOPOLOGY_V1*>(pComputeTopo);
             pComputeTopoV1->gpuCount = cudaCapableGpus.size();
+            if (cudaCapableGpus.size() > NVAPI_MAX_GPU_PER_TOPOLOGY)
+                return InsufficientBuffer(n);
             for (auto i = 0U; i < cudaCapableGpus.size(); i++) {
                 pComputeTopoV1->computeGpus[i].hPhysicalGpu = cudaCapableGpus[i];
                 pComputeTopoV1->computeGpus[i].flags = flags;
             }
             break;
         }
+        case NV_COMPUTE_GPU_TOPOLOGY_VER: {
+            // V2 returns driver-owned storage, as in ZLUDA's NVAPI path.
+            // PhysX initializes only version: gpuCount/computeGpus are outputs
+            // and may contain arbitrary bits. Never dereference the input pointer.
+            static thread_local NV_COMPUTE_GPU returnedGpus[NVAPI_MAX_PHYSICAL_GPUS];
+            pComputeTopo->gpuCount = cudaCapableGpus.size();
+            if (cudaCapableGpus.size() > NVAPI_MAX_PHYSICAL_GPUS)
+                return InsufficientBuffer(n);
+            for (auto i = 0U; i < cudaCapableGpus.size(); i++) {
+                returnedGpus[i].hPhysicalGpu = cudaCapableGpus[i];
+                returnedGpus[i].flags = flags | NV_COMPUTE_GPU_TOPOLOGY_CUDA_AVAILABLE
+                    | NV_COMPUTE_GPU_TOPOLOGY_CUDA_CAPABLE | NV_COMPUTE_GPU_TOPOLOGY_PHYSICS_AVAILABLE;
+            }
+            pComputeTopo->computeGpus = returnedGpus;
+            break;
+        }
         default:
             return Error(n); // Unreachable, but just to be sure
     }
diff --git a/src/nvapi_interface.cpp b/src/nvapi_interface.cpp
index 3e45558..e95d356 100644
--- a/src/nvapi_interface.cpp
+++ b/src/nvapi_interface.cpp
@@ -11,6 +11,22 @@ static const auto disabled = str::split<std::set<std::string_view, str::CaseInse
 
 static std::once_flag logDisabledOnceFlag;
 
+// Legacy PhysX also asks for this private V2-only entry point. ZLUDA's
+// NVAPI implementation accepts it without inspecting the version field.
+// Reuse the checked public enumerator and its driver-owned output storage.
+static NvAPI_Status __cdecl physxComputeTopologyV2(NV_COMPUTE_GPU_TOPOLOGY* output) {
+    if (!output)
+        return NVAPI_INVALID_ARGUMENT;
+    NV_COMPUTE_GPU_TOPOLOGY result{};
+    result.version = NV_COMPUTE_GPU_TOPOLOGY_VER;
+    auto status = NvAPI_GPU_CudaEnumComputeCapableGpus(&result);
+    if (status == NVAPI_OK) {
+        output->gpuCount = result.gpuCount;
+        output->computeGpus = result.computeGpus;
+    }
+    return status;
+}
+
 static void logDisabled() {
     std::set<std::string_view, str::CaseInsensitiveCompare<std::string_view>> known;
     std::vector<std::string_view> recognized, unrecognized;
@@ -54,6 +70,14 @@ NVAPI_QUERY_INTERFACE nvapi_QueryInterface(NvU32 id) {
 
     std::call_once(logDisabledOnceFlag, logDisabled);
 
+    if (id == 0x36e39e6b) {
+        void* method = disabled.find("NvAPI_GPU_CudaEnumComputeCapableGpus") == disabled.end()
+            ? reinterpret_cast<void*>(physxComputeTopologyV2) : nullptr;
+        log::info(str::format(n, " (0x36e39e6b): PhysX compute topology V2",
+            method ? "" : " disabled"));
+        return registry.insert({id, method}).first->second;
+    }
+
     auto it = std::find_if(
         std::begin(nvapi_interface_table),
         std::end(nvapi_interface_table),
diff --git a/tests/nvapi_sysinfo.cpp b/tests/nvapi_sysinfo.cpp
index ea58277..05795c0 100644
--- a/tests/nvapi_sysinfo.cpp
+++ b/tests/nvapi_sysinfo.cpp
@@ -281,7 +281,7 @@ TEST_CASE("Sysinfo methods succeed", "[.sysinfo]") {
         };
         auto args = GENERATE(
             Data{VK_DRIVER_ID_NVIDIA_PROPRIETARY, VK_NV_VIEWPORT_ARRAY2_EXTENSION_NAME, 1},
-            Data{VK_DRIVER_ID_MESA_RADV, VK_KHR_FRAGMENT_SHADING_RATE_EXTENSION_NAME, 0},
+            Data{VK_DRIVER_ID_MESA_RADV, VK_KHR_FRAGMENT_SHADING_RATE_EXTENSION_NAME, 1},
             Data{VK_DRIVER_ID_NVIDIA_PROPRIETARY, "ext", 0});
 
         ::SetEnvironmentVariableA("DXVK_NVAPI_ALLOW_OTHER_DRIVERS", "1");
@@ -315,10 +315,27 @@ TEST_CASE("Sysinfo methods succeed", "[.sysinfo]") {
             }
         }
 
-        SECTION("CudaEnumComputeCapableGpus (V2) returns incompatible-struct-version") {
-            NV_COMPUTE_GPU_TOPOLOGY_V2 gpuTopology;
+        SECTION("CudaEnumComputeCapableGpus (V2) ignores uninitialized outputs") {
+            NV_COMPUTE_GPU_TOPOLOGY_V2 gpuTopology{};
             gpuTopology.version = NV_COMPUTE_GPU_TOPOLOGY_VER;
-            REQUIRE(NvAPI_GPU_CudaEnumComputeCapableGpus(&gpuTopology) == NVAPI_INCOMPATIBLE_STRUCT_VERSION);
+            gpuTopology.gpuCount = 0xdeadbeef;
+            gpuTopology.computeGpus = reinterpret_cast<NV_COMPUTE_GPU*>(1);
+            REQUIRE(NvAPI_GPU_CudaEnumComputeCapableGpus(&gpuTopology) == NVAPI_OK);
+            REQUIRE(gpuTopology.gpuCount == args.cudaGpuCount);
+            REQUIRE(gpuTopology.computeGpus);
+            if (gpuTopology.gpuCount) {
+                REQUIRE(gpuTopology.computeGpus[0].hPhysicalGpu == handle);
+                REQUIRE(gpuTopology.computeGpus[0].flags == 0x21001b);
+            }
+        }
+        SECTION("CudaEnumComputeCapableGpus (V2) provides null-array storage") {
+            NV_COMPUTE_GPU_TOPOLOGY_V2 gpuTopology{};
+            gpuTopology.version = NV_COMPUTE_GPU_TOPOLOGY_VER;
+            REQUIRE(NvAPI_GPU_CudaEnumComputeCapableGpus(&gpuTopology) == NVAPI_OK);
+            REQUIRE(gpuTopology.gpuCount == args.cudaGpuCount);
+            REQUIRE(gpuTopology.computeGpus);
+            if (gpuTopology.gpuCount)
+                REQUIRE(gpuTopology.computeGpus[0].hPhysicalGpu == handle);
         }
     }
 
