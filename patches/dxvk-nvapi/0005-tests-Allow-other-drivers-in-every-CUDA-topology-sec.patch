+// validate-methods.py expects the layout of the SDK table
+// clang-format off
 static constexpr struct {
     const char* func;
     NvU32 id;
 } nvapi_undocumented_interface_table[] = {
     { "NvAPI_CUDA_EnumComputeCapableByTopology", 0x36e39e6b },
