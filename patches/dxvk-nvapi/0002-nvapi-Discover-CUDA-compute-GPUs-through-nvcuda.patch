diff --git a/src/nvapi/nvcuda.cpp b/src/nvapi/nvcuda.cpp
new file mode 100644
index 0000000..f3817f5
--- /dev/null
+++ b/src/nvapi/nvcuda.cpp
@@ -0,0 +1,66 @@
+#include "nvcuda.h"
+#include "../util/util_string.h"
+#include "../util/util_log.h"
+
+namespace dxvk {
+    NvCuda::NvCuda() {
+        const auto nvcudaModuleName = "nvcuda.dll";
+        m_nvcudaModule = ::LoadLibraryA(nvcudaModuleName);
+        if (m_nvcudaModule)
+            log::info(str::format("Successfully loaded ", nvcudaModuleName));
+
+        if (!m_nvcudaModule) {
+            auto lastError = ::GetLastError();
+            if (lastError != ERROR_MOD_NOT_FOUND) // Ignore library not found
+                log::info(str::format("Loading ", nvcudaModuleName, " failed with error code: ", lastError));
+
+            return;
+        }
+
+        m_cuInit = GetProcAddress<PFN_cuInit>("cuInit");
+        m_cuDeviceGetCount = GetProcAddress<PFN_cuDeviceGetCount>("cuDeviceGetCount");
+        m_cuDeviceGet = GetProcAddress<PFN_cuDeviceGet>("cuDeviceGet");
+        m_cuDeviceGetLuid = GetProcAddress<PFN_cuDeviceGetLuid>("cuDeviceGetLuid");
+
+        if (m_cuInit && m_cuDeviceGetCount && m_cuDeviceGet && m_cuDeviceGetLuid)
+            return;
+
+        log::info(str::format(nvcudaModuleName, " loaded but does not provide the required CUDA driver API entry points"));
+
+        ::FreeLibrary(m_nvcudaModule);
+        m_nvcudaModule = nullptr;
+    }
+
+    NvCuda::~NvCuda() {
+        if (!m_nvcudaModule)
+            return;
+
+        ::FreeLibrary(m_nvcudaModule);
+        m_nvcudaModule = nullptr;
+    }
+
+    bool NvCuda::IsAvailable() const {
+        return m_nvcudaModule != nullptr;
+    }
+
+    CUresult NvCuda::Init(unsigned int flags) const {
+        return m_cuInit(flags);
+    }
+
+    CUresult NvCuda::DeviceGetCount(int* count) const {
+        return m_cuDeviceGetCount(count);
+    }
+
+    CUresult NvCuda::DeviceGet(CUdevice* device, int ordinal) const {
+        return m_cuDeviceGet(device, ordinal);
+    }
+
+    CUresult NvCuda::DeviceGetLuid(char* luid, unsigned int* deviceNodeMask, CUdevice device) const {
+        return m_cuDeviceGetLuid(luid, deviceNodeMask, device);
+    }
+
+    template <typename T>
+    T NvCuda::GetProcAddress(const char* name) {
+        return reinterpret_cast<T>(reinterpret_cast<void*>(::GetProcAddress(m_nvcudaModule, name)));
+    }
+}
diff --git a/src/nvapi/nvcuda.h b/src/nvapi/nvcuda.h
new file mode 100644
index 0000000..42cd11a
--- /dev/null
+++ b/src/nvapi/nvcuda.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "../nvapi_private.h"
+
+namespace dxvk {
+    // Minimal subset of the public CUDA driver API (cuda.h) that is needed
+    // to correlate CUDA devices with DXGI adapters.
+    using CUresult = int;
+    using CUdevice = int;
+    constexpr CUresult CUDA_SUCCESS = 0;
+
+    class NvCuda {
+
+      public:
+        NvCuda();
+        virtual ~NvCuda();
+
+        [[nodiscard]] virtual bool IsAvailable() const;
+        [[nodiscard]] virtual CUresult Init(unsigned int flags) const;
+        [[nodiscard]] virtual CUresult DeviceGetCount(int* count) const;
+        [[nodiscard]] virtual CUresult DeviceGet(CUdevice* device, int ordinal) const;
+        [[nodiscard]] virtual CUresult DeviceGetLuid(char* luid, unsigned int* deviceNodeMask, CUdevice device) const;
+
+      private:
+        HMODULE m_nvcudaModule{};
+
+        // CUDAAPI is __stdcall on Windows
+        using PFN_cuInit = CUresult(__stdcall*)(unsigned int);
+        using PFN_cuDeviceGetCount = CUresult(__stdcall*)(int*);
+        using PFN_cuDeviceGet = CUresult(__stdcall*)(CUdevice*, int);
+        using PFN_cuDeviceGetLuid = CUresult(__stdcall*)(char*, unsigned int*, CUdevice);
+
+        PFN_cuInit m_cuInit{};
+        PFN_cuDeviceGetCount m_cuDeviceGetCount{};
+        PFN_cuDeviceGet m_cuDeviceGet{};
+        PFN_cuDeviceGetLuid m_cuDeviceGetLuid{};
+
+        template <typename T>
+        T GetProcAddress(const char* name);
+    };
+}
